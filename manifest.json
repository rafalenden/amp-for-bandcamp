{
  "manifest_version": 3,
  
  "name": "Amp for Bandcamp",
  "version": "1.7.1",
  "description": "Amplifies Bandcamp functionality with playback controls and UI improvements",

  "icons": {
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png",
    "512": "icons/icon512.png",
    "1024": "icons/icon1024.png"
  },

  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "64": "icons/icon64.png",
      "128": "icons/icon128.png",
      "256": "icons/icon256.png",
      "512": "icons/icon512.png",
      "1024": "icons/icon1024.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "scripts": ["src/background.js"]
  },
  "host_permissions": ["*://*.bcbits.com/*", "*://*.bandcamp.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.bandcamp.com/*"],
      "css": ["src/content/content.css"],
      "js": [
        "vendor/webextension-polyfill.min.js",
        "src/content/content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/*", "vendor/*"],
      "matches": ["*://*.bandcamp.com/*"]
    }
  ],
  "permissions": ["storage"],
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "14",
      "strict_max_version": "*"
    },
    "gecko": {
      "id": "amp-for-bandcamp@enden.com"
    }
  }
}
