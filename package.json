{
  "name": "amp-for-bandcamp",
  "version": "2.0.0",
  "type": "module",
  "description": "Amplifies Bandcamp functionality with playback controls and UI improvements",
  "keywords": [
    "bandcamp",
    "music",
    "browser-extension",
    "safari-extension",
    "chrome-extension",
    "opera-extension",
    "edge-extension",
    "firefox-addon"
  ],
  "author": "Rafał Enden",
  "repository": {
    "type": "git",
    "url": "https://github.com/rafalenden/amp-for-bandcamp.git"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build && wxt build -b firefox && wxt build -b safari",
    "build:safari:web": "wxt build -b safari",
    "build:zip": "wxt zip && wxt zip -b firefox",
    "build:safari": "npm run build:safari:web && xcodebuild -project 'safari/Amp for Bandcamp.xcodeproj' -scheme 'Amp for Bandcamp (macOS)' -configuration Release -derivedDataPath dist/safari clean build",
    "build:all": "npm run build:zip && npm run build:safari",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "pretest": "npm run build",
    "test": "playwright test",
    "test:ui": "npm run build && playwright test --ui",
    "test:debug": "npm run build && playwright test --debug",
    "version": "bash scripts/version",
    "ci": "npm run compile && npm run test:local",
    "test:local": "npm test -- tests/Popup.spec.ts tests/Content.spec.ts",
    "test:live": "npm test -- tests/AlbumPage.spec.ts tests/CollectionPage.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
