#!/usr/bin/env bash

set -euo pipefail

if [ -z "${1:-}" ]; then
  node -p "require(\"./package.json\").version"
else
  sed -i "" "s/^  \"version\": \"[^\"]*\"/  \"version\": \"$1\"/" package.json
  npm install --package-lock-only --ignore-scripts
  sed -i "" "s/MARKETING_VERSION = .*/MARKETING_VERSION = $1/" safari/xcconfig/Base.xcconfig
fi
