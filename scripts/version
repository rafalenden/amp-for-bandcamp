#!/usr/bin/env bash

# Prints the current version, or sets a new one everywhere it is recorded:
# package.json, package-lock.json and the Safari Xcode project.

set -euo pipefail

cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."

# `sed -i` takes its backup suffix differently on macOS and Linux, and the
# release workflow runs this on Linux, so write a backup and remove it.
replace() {
  sed -i.bak -e "$1" "$2"
  rm -- "$2.bak"
}

if [ -z "${1:-}" ]; then
  node -p "require(\"./package.json\").version"
else
  if ! [[ "$1" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "Expected a version like 1.2.3, got: $1" >&2
    exit 1
  fi
  replace "s/^  \"version\": \"[^\"]*\"/  \"version\": \"$1\"/" package.json
  npm install --package-lock-only --ignore-scripts --no-audit --no-fund
  replace "s/^MARKETING_VERSION = .*/MARKETING_VERSION = $1/" safari/xcconfig/Base.xcconfig
fi
